function rootPrefixLength(path: string): number {
  let size: number = strings.length(path);
  if (strings.startsWith(path, "//")) {
    let i: number = 2;
    while (i < size && strings.substring(path, i, i + 1) !== "/") { i = i + 1; }
    if (i > 2 && i < size) {
      let shareStart: number = i + 1;
      i = shareStart;
      while (i < size && strings.substring(path, i, i + 1) !== "/") { i = i + 1; }
      if (i > shareStart) {
        if (i < size) { return i + 1; }
        return i;
      }
    }
  }
  if (size >= 2) {
    let first: string = strings.substring(path, 0, 1);
    if (strings.contains("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz", first) && strings.substring(path, 1, 2) === ":") {
      if (size >= 3 && strings.substring(path, 2, 3) === "/") { return 3; }
      return 2;
    }
  }
  if (strings.startsWith(path, "/")) { return 1; }
  return 0;
}
