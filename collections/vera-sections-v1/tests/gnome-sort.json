    {"name": "duplicates", "function": "gnomeSort", "args": [["a", [["n", 1], ["n", 1], ["n", 1], ["n", 1]]]], "expect": ["a", [["n", 1], ["n", 1], ["n", 1], ["n", 1]]]}
