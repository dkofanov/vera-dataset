function bubbleSort(arr: number[]): number[] {
  let i: number = 0;
  while (i < arr.length()) {
    let j: number = 0;
    while (j < arr.length() - 1) {
      if (arr[j] > arr[j + 1]) {
        let temp: number = arr[j];
        arr[j] = arr[j + 1];
        arr[j + 1] = temp;
      }
      j = j + 1;
    }
    i = i + 1;
  }
  return arr;
}
