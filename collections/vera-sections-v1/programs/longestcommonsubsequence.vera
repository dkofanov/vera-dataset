function longestCommonSubsequence(text1: string, text2: string): string {
  let m: number = strings.length(text1);
  let n: number = strings.length(text2);
  let dp: number[] = [];
  let total: number = (m + 1) * (n + 1);
  let k: number = 0;
  while (k < total) {
    dp.push(0);
    k = k + 1;
  }
  let i: number = 1;
  while (i <= m) {
    let j: number = 1;
    while (j <= n) {
      let c1: string = strings.substring(text1, i - 1, i);
      let c2: string = strings.substring(text2, j - 1, j);
      if (c1 === c2) {
        dp[i * (n + 1) + j] = dp[(i - 1) * (n + 1) + (j - 1)] + 1;
      } else {
        let up: number = dp[(i - 1) * (n + 1) + j];
        let left: number = dp[i * (n + 1) + (j - 1)];
        if (up > left) {
          dp[i * (n + 1) + j] = up;
        } else {
          dp[i * (n + 1) + j] = left;
        }
      }
      j = j + 1;
    }
    i = i + 1;
  }
  let ci: number = m;
  let cj: number = n;
  let chars: string[] = [];
  while (ci > 0 && cj > 0) {
    let a: string = strings.substring(text1, ci - 1, ci);
    let b: string = strings.substring(text2, cj - 1, cj);
    if (a === b) {
      chars.push(a);
      ci = ci - 1;
      cj = cj - 1;
    } else {
      let upv: number = dp[(ci - 1) * (n + 1) + cj];
      let leftv: number = dp[ci * (n + 1) + (cj - 1)];
      if (upv > leftv) {
        ci = ci - 1;
      } else {
        cj = cj - 1;
      }
    }
  }
  let result: string = "";
  let p: number = chars.length() - 1;
  while (p >= 0) {
    result = result + chars[p];
    p = p - 1;
  }
  return result;
}
