import * as math from "std/math"

function bubbleSort(arr: number[]): number[] {
  let i: number = 0;
  while (i < arr.length()) {
    let j: number = 0;
    while (j < arr.length() - 1) {
      if (arr[j] > arr[j + 1]) {
        let temp: number = arr[j];
        arr[j] = arr[j + 1];
        arr[j + 1] = temp;
      }
      j = j + 1;
    }
    i = i + 1;
  }
  return arr;
}

function insertionSort(arr: number[]): number[] {
  let i: number = 1;
  while (i < arr.length()) {
    let temp: number = arr[i];
    let j: number = i - 1;
    while (j >= 0 && arr[j] > temp) {
      arr[j + 1] = arr[j];
      j = j - 1;
    }
    arr[j + 1] = temp;
    i = i + 1;
  }
  return arr;
}

function selectionSort(items: number[]): number[] {
  let i: number = 0;
  while (i < items.length()) {
    let minimum: number = i;
    let j: number = i + 1;
    while (j < items.length()) {
      if (items[j] < items[minimum]) {
        minimum = j;
      }
      j = j + 1;
    }
    if (i !== minimum) {
      let temp: number = items[i];
      items[i] = items[minimum];
      items[minimum] = temp;
    }
    i = i + 1;
  }
  return items;
}

function shellSort(arr: number[]): number[] {
  let gap: number = math.floor(arr.length() / 2);
  while (gap > 0) {
    let i: number = gap;
    while (i < arr.length()) {
      let temp: number = arr[i];
      let j: number = i;
      while (j >= gap && arr[j - gap] > temp) {
        arr[j] = arr[j - gap];
        j = j - gap;
      }
      arr[j] = temp;
      i = i + 1;
    }
    gap = math.floor(gap / 2);
  }
  return arr;
}

function gnomeSort(arr: number[]): number[] {
  if (arr.length() <= 1) {
    return arr;
  }
  let i: number = 1;
  while (i < arr.length()) {
    if (arr[i - 1] <= arr[i]) {
      i = i + 1;
    } else {
      let temp: number = arr[i];
      arr[i] = arr[i - 1];
      arr[i - 1] = temp;
      i = i - 1;
      if (i < 1) {
        i = 1;
      }
    }
  }
  return arr;
}
