import * as math from "std/math"

function jumpSearch(array: number[], target: number): number {
  if (array.length() === 0) {
    return -1;
  }
  let stepSize: number = math.floor(math.sqrt(array.length()));
  let current: number = 0;
  let next: number = stepSize;
  while (array[next - 1] < target) {
    current = next;
    next = next + stepSize;
    if (next > array.length()) {
      next = array.length();
      break;
    }
  }
  let index: number = current;
  while (index < next) {
    if (array[index] === target) {
      return index;
    }
    index = index + 1;
  }
  return -1;
}

function interpolationSearch(array: number[], target: number): number {
  let low: number = 0;
  let high: number = array.length() - 1;
  while (low <= high) {
    let lowValue: number = array[low];
    let highValue: number = array[high];
    if (lowValue === highValue) {
      if (array[low] === target) {
        return low;
      }
      return -1;
    }
    let pos: number = math.round(low + ((target - lowValue) * (high - low)) / (highValue - lowValue));
    if (pos < 0 || pos >= array.length()) {
      return -1;
    }
    let currentValue: number = array[pos];
    if (target === currentValue) {
      return pos;
    }
    if (target > currentValue) {
      low = pos + 1;
    } else {
      high = pos - 1;
    }
  }
  return -1;
}

function binarySearchIterative(array: number[], target: number): number | null {
  if (array.length() === 0) {
    return null;
  }
  let start: number = 0;
  let end: number = array.length() - 1;
  if (target < array[start] || target > array[end]) {
    return null;
  }
  let middle: number = math.floor((start + end) / 2);
  while (array[middle] !== target && start <= end) {
    if (target < array[middle]) {
      end = middle - 1;
    } else {
      start = middle + 1;
    }
    middle = math.floor((start + end) / 2);
  }
  if (array[middle] === target) {
    return middle;
  }
  return null;
}

function binarySearchRecursiveRange(array: number[], target: number, start: number, end: number): number | null {
  if (array.length() === 0) {
    return null;
  }
  if (target < array[start] || target > array[end]) {
    return null;
  }
  let middle: number = math.floor((start + end) / 2);
  if (array[middle] === target) {
    return middle;
  }
  if (start > end) {
    return null;
  }
  if (target < array[middle]) {
    return binarySearchRecursiveRange(array, target, start, middle - 1);
  }
  return binarySearchRecursiveRange(array, target, middle + 1, end);
}

function binarySearchRecursive(array: number[], target: number): number | null {
  return binarySearchRecursiveRange(array, target, 0, array.length() - 1);
}

function isSortedArray(arr: number[]): boolean {
  let i: number = 0;
  while (i < arr.length() - 1) {
    if (arr[i] >= arr[i + 1]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}
