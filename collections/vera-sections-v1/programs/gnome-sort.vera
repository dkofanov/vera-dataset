function gnomeSort(arr: number[]): number[] {
  if (arr.length() <= 1) {
    return arr;
  }
  let i: number = 1;
  while (i < arr.length()) {
    if (arr[i - 1] <= arr[i]) {
      i = i + 1;
    } else {
      let temp: number = arr[i];
      arr[i] = arr[i - 1];
      arr[i - 1] = temp;
      i = i - 1;
      if (i < 1) {
        i = 1;
      }
    }
  }
  return arr;
}
