function phi(n: number): number {
  let result: number = n
  let m: number = n
  let i: number = 2
  while (i * i <= m) {
    if (m % i === 0) {
      while (m % i === 0) {
        m = m / i
      }
      result = result - math.floor(result / i)
    }
    i = i + 1
  }
  if (m > 1) {
    result = result - math.floor(result / m)
  }
  return result
}
