function absoluteValue(number: number): number {
  if (number < 0) {
    return -number;
  }
  return number;
}

function nthFibonacci(number: number): number {
  let a: number = 0;
  let b: number = 1;
  let i: number = 0;
  while (i < number) {
    let next: number = a + b;
    a = b;
    b = next;
    i = i + 1;
  }
  return a;
}

function nthFibonacciRecursively(number: number): number {
  if (number === 0) {
    return 0;
  }
  if (number <= 2) {
    return 1;
  }
  return nthFibonacciRecursively(number - 1) + nthFibonacciRecursively(number - 2);
}
