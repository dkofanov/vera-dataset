class RangeCov {
  startOffset: number;
  endOffset: number;
  count: number;
}

class FunctionCov {
  functionName: string;
  ranges: RangeCov[];
  isBlockCoverage: boolean;
}

function makeRange(startOffset: number, endOffset: number, count: number): RangeCov {
  return {
    startOffset: startOffset,
    endOffset: endOffset,
    count: count
  };
}

function makeFunction(functionName: string, ranges: RangeCov[], isBlockCoverage: boolean): FunctionCov {
  return {
    functionName: functionName,
    ranges: ranges,
    isBlockCoverage: isBlockCoverage
  };
}

function functionRangeCount(functionCov: FunctionCov): number {
  return functionCov.ranges.length();
}
