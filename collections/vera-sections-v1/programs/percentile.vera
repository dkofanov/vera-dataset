function isNaNValue(x: number): boolean {
  return x !== x;
}

function sortAscending(values: number[]): number[] {
  let result: number[] = [];
  let i: number = 0;
  while (i < values.length()) {
    result.push(values[i]);
    i = i + 1;
  }
  let n: number = result.length();
  let a: number = 0;
  while (a < n) {
    let b: number = 0;
    while (b < n - 1 - a) {
      let x: number = result[b];
      let y: number = result[b + 1];
      let xNaN: boolean = isNaNValue(x);
      let yNaN: boolean = isNaNValue(y);
      let swap: boolean = false;
      if (xNaN && yNaN) {
        swap = false;
      } else if (xNaN) {
        swap = true;
      } else if (yNaN) {
        swap = false;
      } else if (x > y) {
        swap = true;
      }
      if (swap) {
        let tmp: number = result[b];
        result[b] = result[b + 1];
        result[b + 1] = tmp;
      }
      b = b + 1;
    }
    a = a + 1;
  }
  return result;
}

function percentile(arr: number[], p: number): number {
  if (arr.length() === 0) {
    return 0 / 0;
  }
  let sorted: number[] = sortAscending(arr);
  if (p === 0) {
    return sorted[0];
  }
  let index: number = math.ceil(sorted.length() * (p / 100)) - 1;
  return sorted[index];
}
