import * as math from "std/math"

function binarySearchRange(array: number[], target: number, start: number, end: number): number | null {
  let low: number = start;
  let high: number = end;
  while (low <= high) {
    let middle: number = math.floor((low + high) / 2);
    if (array[middle] === target) {
      return middle;
    }
    if (array[middle] < target) {
      low = middle + 1;
    } else {
      high = middle - 1;
    }
  }
  return null;
}

function exponentialSearch(array: number[], target: number): number | null {
  let length: number = array.length();
  if (length === 0) {
    return null;
  }
  if (array[0] === target) {
    return 0;
  }
  let i: number = 1;
  while (i < length && array[i] <= target) {
    i = i * 2;
  }
  let start: number = math.floor(i / 2);
  let end: number = math.min(i, length - 1);
  return binarySearchRange(array, target, start, end);
}
