function insertionSort(arr: number[]): number[] {
  let i: number = 1;
  while (i < arr.length()) {
    let temp: number = arr[i];
    let j: number = i - 1;
    while (j >= 0 && arr[j] > temp) {
      arr[j + 1] = arr[j];
      j = j - 1;
    }
    arr[j + 1] = temp;
    i = i + 1;
  }
  return arr;
}
