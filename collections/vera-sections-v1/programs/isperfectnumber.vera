function isPerfectNumber(n: number): boolean {
  if (n <= 0) {
    return false
  }
  if (n !== math.floor(n)) {
    return false
  }
  if (n === 1) {
    return false
  }
  let sum: number = 1
  let sqrt: number = math.sqrt(n)
  let i: number = 2
  while (i < sqrt) {
    if (n % i === 0) {
      sum = sum + i + n / i
    }
    i = i + 1
  }
  if (sqrt === math.floor(sqrt)) {
    sum = sum + sqrt
  }
  return sum === n
}
