function compatIndex(compatLocalValue: number, compatLocalLength: number): number {
  let compatLocalIndex: number = math.floor(math.abs(compatLocalValue));
  if (compatLocalValue < 0) { compatLocalIndex = -compatLocalIndex; }
  if (compatLocalIndex < 0) { return math.max(compatLocalLength + compatLocalIndex, 0); }
  return math.min(compatLocalIndex, compatLocalLength);
}

function compatArraySliceNumber(compatLocalValues: number[], compatLocalStart: number, compatLocalEnd: number, compatLocalHasEnd: boolean): number[] {
  let compatLocalLength: number = compatLocalValues.length();
  let compatLocalA: number = compatIndex(compatLocalStart, compatLocalLength);
  let compatLocalB: number = compatLocalLength;
  if (compatLocalHasEnd) { compatLocalB = compatIndex(compatLocalEnd, compatLocalLength); }
  let compatLocalResult: number[] = [];
  while (compatLocalA < compatLocalB) { compatLocalResult.push(compatLocalValues[compatLocalA]); compatLocalA = compatLocalA + 1; }
  return compatLocalResult;
}

function tail(arr: number[]): number[] {
return compatArraySliceNumber(arr, 1, 0, false);
}
